# Google Calendar MCP — path inside the google-calendar-mcp container
# Mounted from ./config/credentials/gcp-oauth.keys.json by docker-compose
GOOGLE_OAUTH_CREDENTIALS=/config/gcp-oauth.keys.json

# Linear webhook signing secret (Story 4 / DUS-9)
# Linear → Settings → API → Webhooks → New webhook → "Signing secret".
# Used by services/linear-webhook-listener for HMAC-SHA256 verification.
LINEAR_WEBHOOK_SECRET=

# Smee.io channel URL (Story 4 / DUS-9, free tunnel — alternative to ngrok).
# Create at https://smee.io/new and paste the channel URL here. The
# `make smee-forward` target streams events from Smee → localhost:3000.
# Leave empty if using ngrok or another tunnel.
SMEE_URL=

# scheduler-state DB path (override only if you want a non-default location)
# DB_PATH=/app/data/scheduler.db
# PREFS_PATH=/app/config/preferences.yaml
